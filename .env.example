# ╔═══════════════════════════════════════════════════════════════════╗
# ║  CENEXA CHATFLOW — environment variable reference                ║
# ║  Copy to .env.local and fill in the values.                      ║
# ║  NEVER commit .env.local — it is already in .gitignore.          ║
# ╚═══════════════════════════════════════════════════════════════════╝
#
# ⚠️  ROTATE IMMEDIATELY if any of these values were previously exposed:
#   - WHATSAPP_ACCESS_TOKEN   (Meta Business > System Users > Generate Token)
#   - NEXT_PUBLIC_SUPABASE_ANON_KEY   (Supabase project settings)
#   - SUPABASE_SERVICE_ROLE_KEY       (Supabase project settings)
#   - OPENROUTER_API_KEY              (openrouter.ai)
#
# Steps to rotate:
#   1. Meta access token  → Meta Business Suite > Users > System Users > [user] > Generate new token
#   2. Supabase keys      → Supabase Dashboard > Project Settings > API > Reset service-role key
#   3. OpenRouter key     → openrouter.ai > Keys > Delete + create new
#   4. Update the values in Vercel (or your hosting env) and in your local .env.local

# ── Meta WhatsApp Business API ────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=           # Permanent access token from Meta Business > System Users > Generate Token
WHATSAPP_PHONE_NUMBER_ID=        # Phone Number ID from Meta App > WhatsApp > API Setup
WHATSAPP_VERIFY_TOKEN=           # Any string you choose (e.g. "myverifytoken123") — used to verify webhook
# API-only number owners enter their own PIN during onboarding; do not use a shared PIN.

# ── Webhook security ──────────────────────────────────────────────────────
# Meta App Secret (App settings > Basic). Enables X-Hub-Signature-256 verification.
META_APP_SECRET=                 # From Meta App Dashboard > Settings > Basic > App Secret
# Signature verification mode: "enforce" in production (default) | "log" | "off" (local development only)
META_APP_SIGNATURE_MODE=enforce
# Graph API version for every server-side Meta call
META_GRAPH_VERSION=v25.0

# ── Meta Embedded Signup (onboarding) ────────────────────────────────────
NEXT_PUBLIC_META_APP_ID=         # Meta App ID (from App Dashboard)
NEXT_PUBLIC_FB_CONFIG_ID=        # Embedded Signup config ID (from Meta Business > WhatsApp > Embedded Signup)
NEXT_PUBLIC_META_GRAPH_VERSION=v25.0
# Set to "false" to disable the coexistence (WhatsApp Business app + Cloud API) signup path
NEXT_PUBLIC_ENABLE_COEXISTENCE=true
META_APP_SECRET=                 # Same as above, server-side copy for callback

# ── AI Model (OpenRouter or OpenAI-compatible) ────────────────────────────
OPENROUTER_API_KEY=              # API key from openrouter.ai (used as fallback if not set per-business)
AI_MODEL=minimax/minimax-m2.5:free  # Default model via OpenRouter

# ── Voice note transcription (any OpenAI-compatible endpoint) ─────────────
# OpenAI: model gpt-4o-transcribe
# Groq:   TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1  model=whisper-large-v3
TRANSCRIBE_API_KEY=              # Falls back to OPENAI_API_KEY if unset. Leave blank to disable voice AI.
TRANSCRIBE_BASE_URL=https://api.openai.com/v1
TRANSCRIBE_MODEL=gpt-4o-transcribe
# TRANSCRIBE_LANGUAGE=ta         # Optional ISO-639-1 hint; leave unset for auto-detect (Tamil/English mix)

# ── Image + transcript analysis (OpenRouter vision-capable model) ──────────
VISION_MODEL=openai/gpt-4o-mini  # Per-business override available via businesses.vision_model column

# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=        # Supabase project URL (e.g. https://xxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # Supabase anon/public key (for frontend)
SUPABASE_SERVICE_ROLE_KEY=       # Supabase service role key (for backend/webhook) — keep secret!

# ── App Config ────────────────────────────────────────────────────────────
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Local UI preview with sample data, no login or Supabase needed (npm run dev only;
# ignored in production builds). Open http://localhost:3000/today
NEXT_PUBLIC_DEMO_MODE=false

# ── Owner alerts ─────────────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=       # Public key generated once with `npx web-push generate-vapid-keys`
VAPID_PRIVATE_KEY=                  # Keep server-side only; never expose in NEXT_PUBLIC variables
VAPID_SUBJECT=                      # Public contact URI (for example, a monitored mailto: address)
CRON_SECRET=                        # Random secret used by the scheduled owner-alert reminder job
# Google Sheets contacts export (server-only OAuth credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SHEETS_REDIRECT_URI=          # Exact deployed URL: /api/integrations/google/callback
GOOGLE_SHEETS_TOKEN_ENCRYPTION_KEY=  # Base64 encoding of 32 random bytes; do not rotate without re-encrypting stored tokens
# Create and approve a Meta utility template with three body parameters:
# {{1}} alert type, {{2}} customer phone, {{3}} dashboard link.
WHATSAPP_OWNER_ALERT_TEMPLATE=      # Approved template name, e.g. cenexa_owner_alert
WHATSAPP_OWNER_ALERT_LANGUAGE=en   # Approved template language code
